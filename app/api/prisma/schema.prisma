generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  phoneNumber String @unique

  // Public email address generated from the Indian national number.
  // Example: 9876543210@phonemail.tech
  emailAddress String @unique

  isActive Boolean @default(true)

  phoneVerifiedAt DateTime

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mailbox   Mailbox?

  @@index([createdAt])
  @@map("users")
}

model Mailbox {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @unique @db.ObjectId
  address     String    @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  messages    Message[]

  @@map("mailboxes")
}

model Message {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  mailboxId      String            @db.ObjectId

  messageId      String            @unique
  threadId       String

  direction      MessageDirection

  sender         String
  recipients     String[]

  subject        String?
  textBody       String?
  htmlBody       String?

  sizeBytes      Int

  receivedAt     DateTime
  sentAt         DateTime?

  isRead         Boolean           @default(false)
  isDeleted      Boolean           @default(false)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  mailbox        Mailbox           @relation(fields: [mailboxId], references: [id])
  attachments    Attachment[]

  @@index([mailboxId, receivedAt])
  @@index([mailboxId, threadId])
  @@index([mailboxId, isRead])
  @@index([mailboxId, isDeleted])
  @@map("messages")
}

model Attachment {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  messageId      String                @db.ObjectId

  originalName   String
  storedName     String
  contentType    String
  sizeBytes      Int
  sha256         String

  scanStatus     AttachmentScanStatus  @default(PENDING)

  createdAt      DateTime              @default(now())

  message        Message               @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("attachments")
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}